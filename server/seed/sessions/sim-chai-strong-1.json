  "content": "def split_bill(total, people, tip_percent):\n    # calculate total with tip\n    tip_amount = total * tip_percent / 100\n    total_with_tip = total + tip_amount\n    # split equally\n    each = total_with_tip / people\n    # round to 2 decimal places\n    each_rounded = round(each, 2)\n    return each_rounded\n\n\nprint(split_bill(1200, 4, 10))\n",
