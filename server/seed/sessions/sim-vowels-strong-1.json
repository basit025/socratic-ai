  "content": "function countVowels(name) {\n  // Return the number of vowels in name\n  var vowels = 0;\n  for (var i = 0; i < name.length; i++) {\n    var ch = name[i].toLowerCase();\n    if (ch === 'a' || ch === 'e' || ch === 'i' || ch === 'o' || ch === 'u') {\n      vowels++;\n    }\n  }\n  return vowels;\n}\n\nconsole.log(countVowels(\"Ayesha\"));\n",
