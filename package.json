{
  "name": "socratic-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Socratic AI: Strong Fundamentals in the Age of AI. A learning platform that verifies learning with process evidence and a viva on the student's own work.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/dev.ts",
    "build": "vite build --config client/vite.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview --config client/vite.config.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check-secrets": "bash scripts/check-secrets.sh"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
