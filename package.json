{
  "name": "socratic-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Socratic AI: Strong Fundamentals in the Age of AI. A learning platform where students do their work in one workspace and the AI mentor Ustaad runs a short viva on each student's own work, so marks reflect what they understand.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/dev.ts",
    "build": "vite build --config client/vite.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview --config client/vite.config.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "check-secrets": "bash scripts/check-secrets.sh",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "seed": "tsx server/seed/seed.ts",
    "smoke:ui": "tsx scripts/smoke-ui.ts",
    "e2e:viva": "tsx scripts/e2e-viva.ts",
    "session:export": "tsx scripts/session-export.ts",
    "demo:generate": "tsx scripts/generate-demo-class.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "express": "5.3.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "puppeteer-core": "^25.18.1",
    "pyodide": "^314.0.8",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "homepage": "https://socratic-ai-pk.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basit025/socratic-ai.git"
  }
}
