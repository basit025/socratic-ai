# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables.
# Preview and Production use DIFFERENT AI keys (and a different Supabase project),
# so testing never uses up the demo quota or touches demo data.

# AI providers (server only). One account per provider per environment.
# Locally, each teammate uses keys from their OWN accounts.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter model id from openrouter.ai/models (must support structured outputs)
OPENROUTER_MODEL=
# First provider to try: "gemini" (default), "groq" or "openrouter".
# On 429/5xx/timeout the server retries once, then moves down the chain: gemini -> groq -> openrouter.
LLM_PROVIDER=gemini

# Supabase
SUPABASE_URL=
# Safe for the browser (row-level security applies)
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never expose it to the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=
